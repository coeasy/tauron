{
  "name": "tauron-workspace",
  "private": true,
  "version": "1.1.0",
  "description": "tauron — Tauri 2 之上的插件化桌面客户端基础设施 monorepo",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:rust": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fmt:rust": "cargo fmt --all",
    "fmt:rust:check": "cargo fmt --all -- --check",
    "verify": "pnpm -r build && pnpm -r --no-bail typecheck && pnpm -r --no-bail test",
    "docs:check": "node scripts/check-doc-line-refs.mjs",
    "gate:assembly-singleton": "node scripts/check-runtime-assembly-singleton.mjs",
    "gate:wasm-generation": "node scripts/check-wasm-loaded-generation.mjs",
    "gate:upgrade-hash": "node scripts/check-upgrade-file-hash.mjs",
    "gate:success-effect": "node scripts/check-success-requires-effect.mjs",
    "gate:simulated-commits": "node scripts/check-simulated-never-commits.mjs",
    "gate:orphan-api": "node scripts/check-orphan-public-api.mjs",
    "gate:domain-ownership": "node scripts/check-adapter-domain-ownership.mjs",
    "gate:tier-bundle": "node scripts/check-tier-bundle.mjs",
    "gates:check": "node scripts/check-runtime-assembly-singleton.mjs && node scripts/check-wasm-loaded-generation.mjs && node scripts/check-upgrade-file-hash.mjs && node scripts/check-success-requires-effect.mjs && node scripts/check-simulated-never-commits.mjs && node scripts/check-orphan-public-api.mjs && node scripts/check-adapter-domain-ownership.mjs && node scripts/check-adapter-domain-ownership.mjs --self-test && node scripts/check-tier-bundle.mjs",
    "command-surface:gen": "node scripts/generate-command-surface.mjs",
    "command-surface:check": "node scripts/generate-command-surface.mjs --check",
    "publish:npm": "node scripts/publish-npm.mjs",
    "publish:crates": "node scripts/publish-crates.mjs",
    "verify:registry-consumer": "node scripts/verify-registry-consumer.mjs",
    "version:check": "node scripts/version-sync.mjs --check",
    "version:sync": "node scripts/version-sync.mjs --set"
  },
  "devDependencies": {
    "@tauri-apps/api": "2.11.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.1"
  }
}
