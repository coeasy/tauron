{
  "name": "@tauron/dual-world",
  "version": "1.0.2",
  "description": "tauron B+ 双世界原型（设计文档 §4.3 B+）：QuickJS-WASM 沙箱、JS↔WASM 桥接、沙箱配置",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/coeasy/tauron.git",
    "directory": "packages/tauron-dual-world"
  },
  "homepage": "https://github.com/coeasy/tauron",
  "bugs": {
    "url": "https://github.com/coeasy/tauron/issues"
  },
  "keywords": [
    "tauron",
    "tauri",
    "plugin",
    "sandbox",
    "quickjs",
    "wasm"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tauron/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
