{
  "name": "@tauron/core",
  "version": "0.1.0",
  "private": true,
  "description": "tauron 框架无关核心层（设计文档 §1.1/§2/§3/§4/§9）：信封调用、双层 ACL、注册表、事件总线、配置管理、运行时探测",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./tauri": {
      "types": "./dist/tauri-backend.d.ts",
      "default": "./dist/tauri-backend.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tauron/types": "workspace:*"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.5.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tauri-apps/api": "2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
