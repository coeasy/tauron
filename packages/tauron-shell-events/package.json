{
  "name": "@tauron/shell-events",
  "version": "1.1.0",
  "description": "tauron 壳层事件契约：oc-* 事件名常量与 detail 类型（零依赖，UI 组件与宿主控制器共用的唯一事实源）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/coeasy/tauron.git",
    "directory": "packages/tauron-shell-events"
  },
  "homepage": "https://github.com/coeasy/tauron",
  "bugs": {
    "url": "https://github.com/coeasy/tauron/issues"
  },
  "keywords": [
    "tauron",
