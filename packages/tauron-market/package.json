{
  "name": "@tauron/market",
  "version": "1.0.0",
  "description": "tauron 插件市场（设计文档 §8）：Ed25519 签名、index.json 生成、插件注册表",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/coeasy/tauron.git",
    "directory": "packages/tauron-market"
  },
  "homepage": "https://github.com/coeasy/tauron",
  "bugs": {
    "url": "https://github.com/coeasy/tauron/issues"
  },
  "keywords": [
    "tauron",
    "tauri",
    "plugin",
    "market",
    "ed25519",
    "signing"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tauron/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.13.5",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
