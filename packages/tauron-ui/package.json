{
  "name": "@tauron/ui",
  "version": "0.1.0",
  "private": true,
  "description": "tauron UI 便利包：转出零宿主依赖的原语（@tauron/ui-primitives）+ 需要宿主命令面的 PluginManagerStore",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./wc": {
      "types": "./dist/wc.d.ts",
      "default": "./dist/wc.js"
    },
    "./plugin-manager": {
      "types": "./dist/plugin-manager.d.ts",
      "default": "./dist/plugin-manager.js"
    },
    "./theme-picker": {
      "types": "./dist/theme-picker.d.ts",
      "default": "./dist/theme-picker.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/wc.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "dependencies": {
    "@tauron/host": "workspace:*",
    "@tauron/ui-primitives": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "happy-dom": "^17.0.0",
    "lit": "^3.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
