{
  "name": "@tauron/adapter-vue",
  "version": "1.0.2",
  "description": "tauron Vue 适配器（设计文档 §4.2）：useInvoke/useEvent/useCapabilities composables、ReactiveStore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/coeasy/tauron.git",
    "directory": "packages/tauron-adapter-vue"
  },
  "homepage": "https://github.com/coeasy/tauron",
  "bugs": {
    "url": "https://github.com/coeasy/tauron/issues"
  },
  "keywords": [
    "tauron",
    "tauri",
    "vue",
    "composables",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tauron/types": "workspace:*",
    "@tauron/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "vue": "^3.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
